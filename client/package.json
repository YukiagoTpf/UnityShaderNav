{
  "name": "unity-shader-nav",
  "displayName": "UnityShaderNav",
  "description": "Code navigation and authoring support for Unity ShaderLab and HLSL.",
  "version": "0.2.0",
  "publisher": "Yukiago",
  "private": true,
  "license": "MIT",
  "icon": "images/icon.png",
  "preview": true,
  "pricing": "Free",
  "homepage": "https://github.com/YukiagoTpf/UnityShaderNav#readme",
  "bugs": {
    "url": "https://github.com/YukiagoTpf/UnityShaderNav/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YukiagoTpf/UnityShaderNav.git",
    "directory": "client"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "unity",
    "shader",
    "shaderlab",
    "hlsl",
    "cg",
    "urp",
    "hdrp",
    "navigation",
    "intellisense",
    "language-server"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:shaderlab",
    "onLanguage:hlsl",
    "onLanguage:shadergraph",
    "onCommand:unityShaderNav.openVisualLab"
  ],
  "contributes": {
    "commands": [
      {
        "command": "unityShaderNav.showIndexStatus",
        "title": "Show Index Status",
        "category": "UnityShaderNav"
      },
      {
        "command": "unityShaderNav.showOutput",
        "title": "Show Output",
        "category": "UnityShaderNav"
      },
      {
        "command": "unityShaderNav.pickIncludePointContext",
        "title": "Select Shader Include-point Context",
        "category": "UnityShaderNav"
      },
      {
        "command": "unityShaderNav.openShaderSource",
        "title": "Open Source Shader View",
        "category": "UnityShaderNav"
      },
      {
        "command": "unityShaderNav.openPreprocessedShader",
        "title": "Open Preprocessed Shader View",
        "category": "UnityShaderNav"
      },
      {
        "command": "unityShaderNav.openGeneratedShader",
        "title": "Open Generated Shader View",
        "category": "UnityShaderNav"
      },
      {
        "command": "unityShaderNav.goToCompilerMappedSource",
        "title": "Go to Compiler-mapped Source",
        "category": "UnityShaderNav"
      },
      {
        "command": "unityShaderNav.goToPreprocessedMapping",
        "title": "Go to Preprocessed Compiler Mapping",
        "category": "UnityShaderNav"
      },
      {
        "command": "unityShaderNav.goToGeneratedMapping",
        "title": "Go to Generated Compiler Mapping",
        "category": "UnityShaderNav"
      },
      {
        "command": "unityShaderNav.showMaterialContext",
        "title": "Show Selected Material Context",
        "category": "UnityShaderNav"
      },
      {
        "command": "unityShaderNav.showVariantComparison",
        "title": "Show Variant Build Comparison",
        "category": "UnityShaderNav"
      },
      {
        "command": "unityShaderNav.showPortabilityReport",
        "title": "Show Custom Shader Portability Report",
        "category": "UnityShaderNav"
      },
      {
        "command": "unityShaderNav.previewPropertyRename",
        "title": "Preview Safe Cross-asset Shader Property Rename",
        "category": "UnityShaderNav"
      },
      {
        "command": "unityShaderNav.openVisualLab",
        "title": "Open Visual Lab",
        "category": "UnityShaderNav"
      }
    ],
    "languages": [
      {
        "id": "shaderlab",
        "aliases": [
          "ShaderLab",
          "Unity Shader"
        ],
        "extensions": [
          ".shader"
        ],
        "configuration": "./language-configuration/shader.json"
      },
      {
        "id": "hlsl",
        "aliases": [
          "HLSL",
          "Unity HLSL"
        ],
        "extensions": [
          ".hlsl",
          ".cginc",
          ".hlslinc",
          ".compute"
        ],
        "configuration": "./language-configuration/hlsl.json"
      },
      {
        "id": "shadergraph",
        "aliases": [
          "Unity Shader Graph",
          "Shader Graph"
        ],
        "extensions": [
          ".shadergraph"
        ]
      }
    ],
    "configuration": {
      "title": "UnityShaderNav",
      "properties": {
        "unityShaderNav.projectRoot": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "Path to Unity project root (containing Assets/ and ProjectSettings/). Empty = autodetect."
        },
        "unityShaderNav.includeDirectories": {
          "type": "array",
          "items": { "type": "string" },
          "scope": "resource",
          "default": [],
          "description": "Extra include search paths."
        },
        "unityShaderNav.excludePatterns": {
          "type": "array",
          "items": { "type": "string" },
          "scope": "resource",
          "default": ["**/Library/**", "**/Temp/**", "**/Logs/**"]
        },
        "unityShaderNav.declarationMacros": {
          "type": "array",
          "scope": "resource",
          "items": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "description": "e.g. MY_TEX2D($name)"
              },
              "kind": {
                "type": "string",
                "enum": ["variable", "cbuffer"]
              }
            },
            "required": ["pattern", "kind"]
          },
          "default": []
        },
        "unityShaderNav.findReferences.includePackages": {
          "type": "boolean",
          "scope": "resource",
          "default": false
        },
        "unityShaderNav.debug.definitionTrace": {
          "type": "boolean",
          "scope": "resource",
          "default": false,
          "description": "Log detailed definition-resolution diagnostics to the UnityShaderNav output channel."
        },
        "unityShaderNav.dimInactiveBranches.enabled": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "Dim inactive preprocessor branches and distinguish variant-dependent branches with a theme-adaptive marker in shader/HLSL files."
        },
        "unityShaderNav.dimInactiveBranches.opacity": {
          "type": "number",
          "scope": "resource",
          "default": 0.55,
          "minimum": 0.1,
          "maximum": 1,
          "description": "Opacity applied to dimmed preprocessor branches (0.1–1)."
        },
        "unityShaderNav.trace.server": {
          "type": "string",
          "scope": "window",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace communication between VS Code and the UnityShaderNav language server in the output channel."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p . && node ../scripts/build.mjs",
    "watch": "tsc -p . -w",
    "vscode:prepublish": "node ../scripts/package-vsix.mjs --prepare-extension-root"
  },
  "dependencies": {
    "@unity-shader-nav/shared": "0.0.1",
    "vscode-languageclient": "^9.0.1",
    "web-tree-sitter": "^0.22.6"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "mocha": "^11.7.6"
  }
}
